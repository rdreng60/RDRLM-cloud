# The same Neon database the web app uses (unpooled is fine here).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/rdr?sslmode=require"

# Gemini
API_KEY="..."

# Must match ENGINE_API_KEY in the web app's environment.
ENGINE_API_KEY="..."

# Optional: only needed if a browser ever calls the engine directly, which the
# current design avoids.
ALLOWED_ORIGINS=""
