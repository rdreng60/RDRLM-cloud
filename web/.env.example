# --- Neon -------------------------------------------------------------------
# Connection string from the Neon console (use the pooled one for Vercel).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/rdr?sslmode=require"

# --- Google sign-in ---------------------------------------------------------
# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Authorised redirect URI:
#   http://localhost:3000/api/auth/callback/google      (development)
#   https://YOUR-APP.vercel.app/api/auth/callback/google (production)
AUTH_GOOGLE_ID="....apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="GOCSPX-..."

# Any random string. Generate with:  npx auth secret
AUTH_SECRET="..."

# Your deployed URL. Not needed locally; Vercel sets it for you.
# AUTH_URL="https://YOUR-APP.vercel.app"

# --- The Python engine ------------------------------------------------------
ENGINE_URL="http://127.0.0.1:8000"
# Must match ENGINE_API_KEY in the engine's environment. Any long random string.
ENGINE_API_KEY="..."

# --- Bootstrap --------------------------------------------------------------
# These addresses can create organisations and edit any allow list. This is how
# the first organisation gets made, before any owner exists. Comma separated.
SUPER_ADMINS="you@gmail.com"
